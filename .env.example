# Copy this file to .env and fill in your values
SNOWFLAKE_ACCOUNT=your_account       # e.g. xy12345.us-west-2.aws
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password     # or use SNOWFLAKE_PRIVATE_KEY_PATH for key-pair auth
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
USE_CORTEX_ANALYST=false             # true = call Cortex Analyst directly (e.g. trial accounts, where Cortex Agents are blocked)
CORS_ORIGINS=*

# Agents the chat can switch between; the first is the default.
# Each ID needs <ID>_DATABASE, <ID>_SCHEMA, <ID>_AGENT_NAME.
# Optional: <ID>_LABEL, <ID>_SEMANTIC_VIEW (needed for Analyst mode), <ID>_WAREHOUSE,
#           <ID>_SUGGESTIONS (questions separated by |).
# Leave AGENTS out to use a single agent from SNOWFLAKE_DATABASE / SNOWFLAKE_SCHEMA / AGENT_NAME / SEMANTIC_VIEW.
AGENTS=SALES
SALES_LABEL=Sales Analytics
SALES_DATABASE=TABLEAU_DEMO
SALES_SCHEMA=TABLEAU_AGENT_DEMO
SALES_AGENT_NAME=SALES_AGENT
SALES_SEMANTIC_VIEW=TABLEAU_DEMO.TABLEAU_AGENT_DEMO.SALES_SEMANTIC_VIEW
SALES_SUGGESTIONS=What is the total revenue by product category?|Who are the top 5 customers by total sales?

# Saved chat history: days to keep/show per browser (0 = off, chat behaves as before).
# Run backend/chat_history_setup.sql once first. Table name is optional.
CHAT_HISTORY_DAYS=7
# CHAT_HISTORY_TABLE=PHARMA_DEMO.CHAT_APP.CHAT_HISTORY
